    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  }
}
