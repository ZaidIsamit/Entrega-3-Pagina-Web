{
  "name": "reservas-unab-api",
  "private": true,
  "version": "3.0.0",
  "description": "API REST de Reservas UNAB (Hito 3): Express + PostgreSQL + MongoDB",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
