# Variables para ejecutar la API fuera de Docker (npm run dev).
# Copia este archivo como .env y ajusta los valores. NO subas el .env al repositorio.
PORT=3000
DATABASE_URL=postgres://reservas:cambiar_esta_clave@localhost:5432/reservas_unab
MONGO_URL=mongodb://localhost:27017
MONGO_DB=reservas_unab
# Usa un valor largo y aleatorio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_TIMEZONE=America/Santiago
