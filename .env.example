# Variables de docker-compose.yml. Copia este archivo como .env para cambiarlas.
# Todas tienen un valor por defecto de desarrollo, así que el .env es opcional.
# NUNCA subas un .env con claves reales al repositorio.

# PostgreSQL
POSTGRES_DB=reservas_unab
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# MongoDB
MONGO_DB=reservas_unab
MONGO_PORT=27017

# API
API_PORT=3000
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Frontend
WEB_PORT=8080
